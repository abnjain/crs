# Copy to docker/render.env (gitignored), fill secrets, then load in Render Dashboard.
# Generate JWT keys: ./docker/generate-jwt-keys.sh

NODE_ENV=production
API_PREFIX=/api
API_INTERNAL_PORT=5000
UPLOAD_DIR=/var/uploads
UPLOAD_PROVIDER=local
CORS_ORIGINS=https://crs.abnjain.me
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
JWT_ALG=RS256
JWT_EXPIRES_IN=7d
LOG_LEVEL=info
AUDIT_CONSOLE_LOGS=false

# MongoDB Atlas — Network Access: 0.0.0.0/0 (or Render static egress on higher plans)
MONGO_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/crs?retryWrites=true&w=majority

# Paste single-line PEM values from generate-jwt-keys.sh output
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"
