# GitHub Actions — copy names/values into repo Settings → Secrets and variables → Actions
# Do NOT commit real values to git.

# --- Switch (Variable OR Secret; value must be lowercase) ---
DEPLOY_TARGET=render

# --- Required when DEPLOY_TARGET=render ---
RENDER_DEPLOY_HOOK=https://api.render.com/deploy/srv-XXXXXXXX?key=YYYYYYYY

# --- Required when DEPLOY_TARGET=k8s ---
# KUBE_CONFIG_PROD=<base64 kubeconfig>
# K8S_OVERLAY_PROD=server/cloud-infra/k8s/overlays/do-prod
# K8S_NAMESPACE_PROD=crs-prod
