# CRS Server - Environment Variables
# Copy to .env and configure

NODE_ENV=development
PORT=5000
API_PREFIX=/api

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/crs

# Redis (optional - caching disabled if not set)
REDIS_URL=redis://127.0.0.1:6379

# JWT (RS256 recommended)
JWT_ALG=RS256
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nREPLACE_ME\n-----END PUBLIC KEY-----"
JWT_SECRET=change-me-in-production-secure-secret
JWT_EXPIRES_IN=7d

# Auth cookies
AUTH_COOKIE_NAME=crs_token
AUTH_COOKIE_MAX_AGE_MS=604800000
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# CSRF
CSRF_COOKIE_NAME=crs_csrf
CSRF_HEADER_NAME=x-csrf-token
CSRF_TOKEN_BYTES=32

# CORS - comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# Logging
LOG_LEVEL=debug
AUDIT_CONSOLE_LOGS=true

# Uploads directory (relative to server cwd) — disk stats in health telemetry
UPLOAD_DIR=uploads

# Upload handling
UPLOAD_PROVIDER=local
MAX_UPLOAD_SIZE_MB=10

# S3 (optional)
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SIGNED_URL_EXPIRES=3600

# SMTP (optional) — surfaced in GET /api/v1/health when set
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=
# SMTP_VERIFY_TIMEOUT_MS=10000
# SMTP_PROBE_CACHE_MS=60000
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_GREETING_TIMEOUT_MS=10000
# SMTP_SOCKET_TIMEOUT_MS=10000
# SMTP_REQUIRE_TLS=false
# SMTP_POOL=false
# SMTP_MAX_CONNECTIONS=5
# SMTP_MAX_MESSAGES=100

# Landing page (optional) — alumni & faculty counts come from MongoDB; tune display figures here
# LANDING_LIBRARY_VOLUMES=8200
# LANDING_FOUNDING_YEAR=1987
